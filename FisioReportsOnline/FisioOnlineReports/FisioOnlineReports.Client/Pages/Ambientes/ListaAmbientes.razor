@page "/ambientes"


<MudText Typo="Typo.h3">Ambientes</MudText>

<MudButton Variant="Variant.Filled"
           StartIcon="@Icons.Material.Filled.Add"
           Color="Color.Info"
           Size="Size.Large"
           @onclick="@(()=> OpenCriar())"
           Class="mt-md-4 mb-4">Novo Ambiente</MudButton>

<MudDataGrid Items="@Ambientes" Filterable="false" SortMode="@SortMode.Single" Groupable="false">
    <Columns>
        <PropertyColumn Property="x=>x.Nome" />
        <TemplateColumn>
            <CellTemplate>
                <MudStack Row>
                    <MudFab Size="Size.Small"
                            Label="Editar"
                            hidden="@HideButtons"
                            @onclick="@(()=> GoToUpdate(context.Item.Id))"
                            StartIcon="@Icons.Material.Filled.Edit"
                            Color="Color.Success" />

                    <MudFab Size="Size.Small"
                            Label="Excluir"
                            hidden="@HideButtons"
                            @onclick="@(()=> DeleteAmbiente(context.Item))"
                            StartIcon="@Icons.Material.Filled.Delete"
                            Color="Color.Error" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

<CriarAmbiente Visible="VisibleNovo" OnClose="CloseCriar"></CriarAmbiente>
<EditarAmbiente Visible="VisibleEditar" OnClose="CloseEditar" AmbienteId="AmbienteId"></EditarAmbiente>

@code {
    private List<Ambiente> Ambientes { get; set; } = new();
    private bool HideButtons = false;
    private bool VisibleEditar = false;
    private bool VisibleNovo = false;
    private int AmbienteId = 0;


    private void OpenEditar() => VisibleEditar = true;

    private void CloseEditar() => VisibleEditar = false;

    private void OpenCriar() => VisibleNovo = true;

    private void CloseCriar() => VisibleNovo = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            var temp = await CarregarAmbientes();
            if (temp != null)
                Ambientes = temp;
        }
    }

    private async Task<List<Ambiente>> CarregarAmbientes()
    {

        AmbienteService ambienteService = new();
        return await ambienteService.ConsultarAmbientes();
    }

    private async void DeleteAmbiente(Ambiente ambiente)
    {
        AmbienteService ambienteService = new();
        await ambienteService.DeleteAmbiente(ambiente.Id);

        Ambientes = await CarregarAmbientes();

        StateHasChanged();
    }

    private void GoToUpdate(int ambienteId)
    {
        AmbienteId = ambienteId;
        OpenEditar();
    }
}
