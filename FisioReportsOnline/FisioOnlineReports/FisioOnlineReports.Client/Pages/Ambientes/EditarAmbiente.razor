<MudDialog @bind-Visible="Visible">
    <DialogContent>

        <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync">
            <DataAnnotationsValidator />

            <MudTextField Label="Nome"
                          Variant="Variant.Outlined"
                          HelperText="Campo obrigatório"
                          @bind-Value="InputModel.Nome"
                          For="@(()=> InputModel.Nome)" />

            <MudDivider Class="m-4" />

            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Save"
                       Color="Color.Info"
                       Size="Size.Large"
                       ButtonType="ButtonType.Submit">
                Salvar
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Close"
                       Color="Color.Info"
                       Size="Size.Large"
                       OnClick="Close">
                Fechar
            </MudButton>

        </EditForm>
    </DialogContent>
</MudDialog>

@code {

    [Parameter]
    public int AmbienteId { get; set; }
    
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task Close() => await OnClose.InvokeAsync(null);

    public AmbienteInputModel InputModel { get; set; } = new();
    private Ambiente Ambiente = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            Ambiente = await CarregarAmbiente();
            if(Ambiente != null)
                InputModel.Nome = Ambiente.Nome;
        }
    }

    public async Task<Ambiente> CarregarAmbiente()
    {
        AmbienteService ambienteService = new();
        return await ambienteService.ConsultarAmbiente(AmbienteId);
    }

    public async Task OnValidSubmitAsync()
    {

        AmbienteService ambienteService= new();
        await ambienteService.AtualizarAmbiente(InputModel);
    }

}
