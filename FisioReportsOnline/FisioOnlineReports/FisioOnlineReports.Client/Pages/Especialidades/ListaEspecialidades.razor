@page "/especialidades"


<MudText Typo="Typo.h3">Especialidades</MudText>

<MudButton Variant="Variant.Filled"
           StartIcon="@Icons.Material.Filled.Add"
           Color="Color.Info"
           Size="Size.Large"
           @onclick="@(()=> OpenCriar())"
           Class="mt-md-4 mb-4">Novo Especialidade</MudButton>

<MudDataGrid Items="@Especialidades" Filterable="false" SortMode="@SortMode.Single" Groupable="false">
    <Columns>
        <PropertyColumn Property="x=>x.Nome" />
        <TemplateColumn>
            <CellTemplate>
                <MudStack Row>
                    <MudFab Size="Size.Small"
                            Label="Editar"
                            hidden="@HideButtons"
                            @onclick="@(()=> GoToUpdate(context.Item.Id))"
                            StartIcon="@Icons.Material.Filled.Edit"
                            Color="Color.Success" />

                    <MudFab Size="Size.Small"
                            Label="Excluir"
                            hidden="@HideButtons"
                            @onclick="@(()=> DeleteEspecialidade(context.Item))"
                            StartIcon="@Icons.Material.Filled.Delete"
                            Color="Color.Error" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

<CriarEspecialidade Visible="VisibleNovo" OnClose="CloseCriar"></CriarEspecialidade>
<EditarEspecialidade Visible="VisibleEditar" OnClose="CloseEditar" EspecialidadeId="EspecialidadeId"></EditarEspecialidade>

@code {
    private List<Especialidade> Especialidades { get; set; } = new();
    private bool HideButtons = false;
    private bool VisibleEditar = false;
    private bool VisibleNovo = false;
    private int EspecialidadeId = 0;


    private void OpenEditar() => VisibleEditar = true;

    private void CloseEditar() => VisibleEditar = false;

    private void OpenCriar() => VisibleNovo = true;

    private void CloseCriar() => VisibleNovo = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            var temp = await CarregarEspecialidades();
            if (temp != null)
                Especialidades = temp;
        }
    }

    private async Task<List<Especialidade>> CarregarEspecialidades()
    {

        EspecialidadeService especialidadeService = new();
        return await especialidadeService.ConsultarEspecialidades();
    }

    private async void DeleteEspecialidade(Especialidade especialidade)
    {
        EspecialidadeService especialidadeService = new();
        await especialidadeService.DeleteEspecialidade(especialidade.Id);

        Especialidades = await CarregarEspecialidades();

        StateHasChanged();
    }

    private void GoToUpdate(int especialidadeId)
    {
        EspecialidadeId = especialidadeId;
        OpenEditar();
    }
}
