<MudDialog @bind-Visible="Visible">
    <DialogContent>

        <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync">
            <DataAnnotationsValidator />

            <MudTextField Label="Nome"
                          Variant="Variant.Outlined"
                          HelperText="Campo obrigatório"
                          @bind-Value="InputModel.Nome"
                          For="@(()=> InputModel.Nome)" />

            <MudDivider Class="m-4" />

            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Save"
                       Color="Color.Info"
                       Size="Size.Large"
                       ButtonType="ButtonType.Submit">
                Salvar
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Close"
                       Color="Color.Info"
                       Size="Size.Large"
                       OnClick="Close">
                Fechar
            </MudButton>

        </EditForm>
    </DialogContent>
</MudDialog>

@code {

    [Parameter]
    public int OrcamentoId { get; set; }
    
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task Close() => await OnClose.InvokeAsync(null);

    public OrcamentoInputModel InputModel { get; set; } = new();
    private Orcamento Orcamento = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            Orcamento = await CarregarOrcamento();
            if(Orcamento != null)
                InputModel.Nome = Orcamento.Nome;
        }
    }

    public async Task<Orcamento> CarregarOrcamento()
    {
        OrcamentoService orcamentoService = new();
        return await orcamentoService.ConsultarOrcamento(OrcamentoId);
    }

    public async Task OnValidSubmitAsync()
    {

        OrcamentoService orcamentoService= new();
        await orcamentoService.AtualizarOrcamento(InputModel);
    }

}
