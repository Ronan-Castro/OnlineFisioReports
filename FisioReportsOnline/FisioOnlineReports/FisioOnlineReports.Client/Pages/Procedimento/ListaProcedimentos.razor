@page "/procedimentos"


<MudText Typo="Typo.h3">Procedimentos</MudText>

<MudButton Variant="Variant.Filled"
           StartIcon="@Icons.Material.Filled.Add"
           Color="Color.Info"
           Size="Size.Large"
           @onclick="@(()=> OpenCriar())"
           Class="mt-md-4 mb-4">Novo Procedimento</MudButton>

<MudDataGrid Items="@Procedimentos" Filterable="false" SortMode="@SortMode.Single" Groupable="false">
    <Columns>
        <PropertyColumn Property="x=>x.Nome" />
        <TemplateColumn>
            <CellTemplate>
                <MudStack Row>
                    <MudFab Size="Size.Small"
                            Label="Editar"
                            hidden="@HideButtons"
                            @onclick="@(()=> GoToUpdate(context.Item.Id))"
                            StartIcon="@Icons.Material.Filled.Edit"
                            Color="Color.Success" />

                    <MudFab Size="Size.Small"
                            Label="Excluir"
                            hidden="@HideButtons"
                            @onclick="@(()=> DeleteProcedimento(context.Item))"
                            StartIcon="@Icons.Material.Filled.Delete"
                            Color="Color.Error" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

<CriarProcedimento Visible="VisibleNovo" OnClose="CloseCriar"></CriarProcedimento>
<EditarProcedimento Visible="VisibleEditar" OnClose="CloseEditar" ProcedimentoId="ProcedimentoId"></EditarProcedimento>

@code {
    private List<Procedimento> Procedimentos { get; set; } = new();
    private bool HideButtons = false;
    private bool VisibleEditar = false;
    private bool VisibleNovo = false;
    private int ProcedimentoId = 0;


    private void OpenEditar() => VisibleEditar = true;

    private void CloseEditar() => VisibleEditar = false;

    private void OpenCriar() => VisibleNovo = true;

    private void CloseCriar() => VisibleNovo = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            var temp = await CarregarProcedimentos();
            if (temp != null)
                Procedimentos = temp;
        }
    }

    private async Task<List<Procedimento>> CarregarProcedimentos()
    {

        ProcedimentoService procedimentoService = new();
        return await procedimentoService.ConsultarProcedimentos();
    }

    private async void DeleteProcedimento(Procedimento procedimento)
    {
        ProcedimentoService procedimentoService = new();
        await procedimentoService.DeleteProcedimento(procedimento.Id);

        Procedimentos = await CarregarProcedimentos();

        StateHasChanged();
    }

    private void GoToUpdate(int procedimentoId)
    {
        ProcedimentoId = procedimentoId;
        OpenEditar();
    }
}
