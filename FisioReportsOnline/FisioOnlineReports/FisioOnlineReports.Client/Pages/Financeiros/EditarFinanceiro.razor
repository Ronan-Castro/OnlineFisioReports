<MudDialog @bind-Visible="Visible">
    <DialogContent>

        <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync">
            <DataAnnotationsValidator />

            <MudTextField Label="Nome"
                          Variant="Variant.Outlined"
                          HelperText="Campo obrigatório"
                          @bind-Value="InputModel.Nome"
                          For="@(()=> InputModel.Nome)" />

            <MudDivider Class="m-4" />

            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Save"
                       Color="Color.Info"
                       Size="Size.Large"
                       ButtonType="ButtonType.Submit">
                Salvar
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Close"
                       Color="Color.Info"
                       Size="Size.Large"
                       OnClick="Close">
                Fechar
            </MudButton>

        </EditForm>
    </DialogContent>
</MudDialog>

@code {

    [Parameter]
    public int FinanceiroId { get; set; }
    
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task Close() => await OnClose.InvokeAsync(null);

    public FinanceiroInputModel InputModel { get; set; } = new();
    private Financeiro Financeiro = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            Financeiro = await CarregarFinanceiro();
            if(Financeiro != null)
                InputModel.Nome = Financeiro.Nome;
        }
    }

    public async Task<Financeiro> CarregarFinanceiro()
    {
        FinanceiroService financeiroService = new();
        return await financeiroService.ConsultarFinanceiro(FinanceiroId);
    }

    public async Task OnValidSubmitAsync()
    {

        FinanceiroService financeiroService= new();
        await financeiroService.AtualizarFinanceiro(InputModel);
    }

}
