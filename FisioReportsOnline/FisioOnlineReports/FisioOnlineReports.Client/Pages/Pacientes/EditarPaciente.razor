@page "/pacientes/editar/{PacienteId:int}"

<MudGrid Justify="Justify.Center"> 
    <MudItem xs="12" sm="8"> 
        <MudPaper Class="pa-8 mt-4">

            <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync">
                <DataAnnotationsValidator />

                <MudTextField Label="Nome"
                              Variant="Variant.Outlined"
                              HelperText="Campo obrigatório"
                              @bind-Value="InputModel.Nome"
                              For="@(()=> InputModel.Nome)" />

                <MudTextField Label="Documento"
                              Variant="Variant.Outlined"
                              HelperText="Campo obrigatório"
                              @bind-Value="InputModel.Documento"
                              Mask="@(new PatternMask("000.000.000-00"))"
                              For="@(()=> InputModel.Documento)" />

                <MudTextField Label="E-mail"
                              Variant="Variant.Outlined"
                              HelperText="Campo obrigatório"
                              @bind-Value="InputModel.Email"
                              For="@(()=> InputModel.Email)" />

                <MudTextField Label="Celular"
                              Variant="Variant.Outlined"
                              HelperText="Campo obrigatório"
                              @bind-Value="InputModel.Celular"
                              Mask="@(new PatternMask("(00) 0 0000-0000"))"
                              For="@(()=> InputModel.Celular)" />

                <MudDatePicker Label="Data de Nascimento"
                               Editable="false"
                               @bind-Date="DataNascimento"
                               Variant="Variant.Outlined"
                               MaxDate="@MaxDate"
                               Placeholder="Data de Nascimento" />

                <MudSelect Class="py-3" @bind-Value="InputModel.ComoConheceu" AdornmentIcon="@Icons.Material.Filled.Workspaces" AdornmentColor="Color.Primary" T="ComoConheceu" AnchorOrigin="Origin.BottomCenter" Variant="Variant.Outlined">
                    <MudSelectItem Value="@(ComoConheceu.Google)">Google</MudSelectItem>
                    <MudSelectItem Value="@(ComoConheceu.Facebook)">Facebook</MudSelectItem>
                    <MudSelectItem Value="@(ComoConheceu.Instagram)">Instagram</MudSelectItem>
                    <MudSelectItem Value="@(ComoConheceu.Localizacao)">Localização</MudSelectItem>
                    <MudSelectItem Value="@(ComoConheceu.Planos)">Planos</MudSelectItem>
                    <MudSelectItem Value="@(ComoConheceu.Convenios)">Convênios</MudSelectItem>
                    <MudSelectItem Value="@(ComoConheceu.Indicacao)">Indicação</MudSelectItem>

                </MudSelect>

                @*Definição dos Ambientes disponíveis*@
                @if (InputModel.ComoConheceu == ComoConheceu.Indicacao && _pacientes != null)
                {
                    <MudSelect Class="py-3" @bind-Value="idPacienteIndicou" AdornmentIcon="@Icons.Material.Filled.Workspaces" AdornmentColor="Color.Primary" T="int" AnchorOrigin="Origin.BottomCenter" Variant="Variant.Outlined">
                        @foreach (var item in _pacientes)
                        {
                            <MudSelectItem Value="@(item.Id)"></MudSelectItem>
                        }
                    </MudSelect>
                }

                <MudDivider Class="m-4" />

                <MudButton Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Save"
                           Color="Color.Info"
                           Size="Size.Large"
                           ButtonType="ButtonType.Submit">
                    SALVAR
                </MudButton>

            </EditForm>

        </MudPaper>
    </MudItem>
</MudGrid>

@code {

    [Parameter]
    public int PacienteId { get; set; }
    
    public PacienteInputModel InputModel { get; set; } = new();
    public DateTime? DataNascimento { get; set; } = DateTime.Today;
    public DateTime? MaxDate { get; set; } = DateTime.Today;
    private List<Paciente> _pacientes = new();
    private int idPacienteIndicou;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            Paciente pacienteEditando = await CarregarPacienteEdicao();
            _pacientes = await CarregarPacientes();
        }
    }

    public async Task<Paciente> CarregarPacienteEdicao()
    {
        PacienteService _PacienteService = new();
        return await _PacienteService.ConsultarPaciente(PacienteId);
    }

    public async Task OnValidSubmitAsync()
    {
        if (DataNascimento != null)
            InputModel.DataNascimento = (DateTime) DataNascimento;

        PacienteService _PacienteService = new();
        await _PacienteService.AtualizarPaciente(InputModel);
    }

    public async Task<List<Paciente>> CarregarPacientes()
    {
        PacienteService _PacienteService = new();
        return await _PacienteService.ConsultarPacientes();
    }
}
